// PushHarmonyProxy.tslib
import reminderAgentManager from '@ohos.reminderAgentManager';
import notificationManager from '@ohos.notificationManager';
import { BusinessError } from '@ohos.base';
import { WantAgent, wantAgent } from '@ohos.app.ability.wantAgent';
import { common } from '@ohos.app.ability.common';

const UNITY_GAMEOBJECT = "PushManager"; // 场景中挂载 Push_harmony 接收方法的 GameObject 名

export class PushHarmonyProxy {
    private static cachedContext: common.UIAbilityContext | null = null;

    /** 在 EntryAbility.onCreate 里调用一次，注入 context */
    static SetContext(context: common.UIAbilityContext): void {
        PushHarmonyProxy.cachedContext = context;
        console.info('[PushHarmonyProxy] context set');
    }

    /** 请求通知权限 */
    static RequestNotificationPermission(): void {
        notificationManager.requestEnableNotification()
            .then(() => console.info('[PushHarmonyProxy] notification permission granted'))
            .catch((err: BusinessError) =>
                console.error(`[PushHarmonyProxy] permission err: code=${err.code}, msg=${err.message}`));
    }

    /** 初始化代理提醒（预留） */
    static InitReminderAgent(): void {
        console.info('[PushHarmonyProxy] reminder agent initialized');
    }

    /** 发布日历类型代理提醒 */
    static async PublishCalendarReminder(
        year: number, month: number, day: number,
        hour: number, minute: number, second: number,
        title: string, content: string, pushKey: string,
        ringDuration: number
    ): Promise<void> {
        try {
            if (!PushHarmonyProxy.cachedContext) {
                console.error('[PushHarmonyProxy] context is null; call SetContext first');
                PushHarmonyProxy.SendToUnity("OnReminderPublished",
                    JSON.stringify({ success: false, pushKey: pushKey, errorMsg: 'context null' }));
                return;
            }

            const bundleName = PushHarmonyProxy.cachedContext.abilityInfo.bundleName;
            const abilityName = PushHarmonyProxy.cachedContext.abilityInfo.name;

            const wantAgentInfo: wantAgent.WantAgentInfo = {
                wants: [{
                    bundleName: bundleName,
                    abilityName: abilityName,
                    parameters: { pushKey: pushKey }
                }],
                actionType: wantAgent.OperationType.START_ABILITY,
                requestCode: 0,
                wantAgentFlags: [wantAgent.WantAgentFlags.UPDATE_PRESENT_FLAG]
            };
            const wantAgentObj: WantAgent = await wantAgent.getWantAgent(wantAgentInfo);

            const reminder: reminderAgentManager.ReminderRequestCalendar = {
                reminderType: reminderAgentManager.ReminderType.REMINDER_TYPE_CALENDAR,
                dateTime: { year, month, day, hour, minute, second },
                title: title,
                content: content,
                expiredContent: content,
                notificationId: 0,
                slotType: notificationManager.SlotType.SOCIAL_COMMUNICATION, // 横幅+铃声
                ringDuration: ringDuration > 0 ? ringDuration : 5,
                wantAgent: wantAgentObj,
                actionButton: []
            };

            const reminderId = await reminderAgentManager.publishReminder(reminder);
            console.info(`[PushHarmonyProxy] published id=${reminderId}, key=${pushKey}`);

            PushHarmonyProxy.SendToUnity("OnReminderPublished",
                JSON.stringify({ success: true, reminderId: reminderId, pushKey: pushKey }));
        } catch (err) {
            const e = err as BusinessError;
            console.error(`[PushHarmonyProxy] publish failed code=${e.code}, msg=${e.message}`);
            PushHarmonyProxy.SendToUnity("OnReminderPublished",
                JSON.stringify({ success: false, pushKey: pushKey, errorCode: e.code, errorMsg: e.message }));
        }
    }

    /** 取消所有代理提醒 */
    static async CancelAllReminders(): Promise<void> {
        try {
            await reminderAgentManager.cancelAllReminders();
            console.info('[PushHarmonyProxy] all reminders cancelled');
        } catch (err) {
            const e = err as BusinessError;
            console.error(`[PushHarmonyProxy] cancelAll failed: ${e.message}`);
        }
    }

    /** 查询有效提醒 */
    static async GetValidReminders(): Promise<void> {
        try {
            const list = await reminderAgentManager.getValidReminders();
            const ids = list.map(r => (r as reminderAgentManager.ReminderRequest).notificationId ?? 0);
            PushHarmonyProxy.SendToUnity("OnValidReminders", JSON.stringify({ ids: ids }));
        } catch (err) {
            const e = err as BusinessError;
            console.error(`[PushHarmonyProxy] getValid failed: ${e.message}`);
        }
    }

    private static SendToUnity(method: string, data: string): void {
        // 按项目的 Unity 桥接 API 调用，通常为：
        // UnityPlayer.UnitySendMessage(UNITY_GAMEOBJECT, method, data);
        console.info(`[PushHarmonyProxy] SendToUnity ${method}: ${data}`);
    }
}