// PushHarmonyProxy.tslib
import { reminderAgentManager } from '@kit.BackgroundTasksKit';
import { notificationManager } from '@kit.NotificationKit';
import { BusinessError, systemDateTime } from '@kit.BasicServicesKit';
import fs from '@ohos.file.fs';
import { TDOpenHarmonyProxy } from './TDOpenHarmonyProxy';
import { DateData } from '@kit.ArkUI';

export class PushHarmonyProxy {

  private bundleName: string = '';
  private abilityName: string = '';
  private filesDir: string = '';   // ★ 由 C# 侧通过 SetConfig 传入

  // ============================================================
  // 配置注入（新增 filesDir 参数）
  // ============================================================
  SetConfig(bundleName: string, abilityName: string, filesDir: string): void {
    this.bundleName = bundleName;
    this.abilityName = abilityName;
    this.filesDir = filesDir;
    console.info('[PushHarmonyProxy] config set, bundleName=' + bundleName +
      ', abilityName=' + abilityName + ', filesDir=' + filesDir);
  }

  InitReminderAgent(): void {
    console.info('[PushHarmonyProxy] reminder agent initialized');
  }

  // ============================================================
  // 请求通知使能：查询状态并写 JSON 文件
  // ============================================================
  async RequestNotificationEnable(): Promise<boolean> {
    try {
      const enabled: boolean = await notificationManager.isNotificationEnabled();
      console.info('[PushHarmonyProxy] notification enabled: ' + enabled);
      this.WriteIsAutoPushJson(enabled);
      var data=systemDateTime.getTime();
      TDOpenHarmonyProxy.track("Pop_accept","消息推送",data,"Local","2c3fcbfea2ff4842b9e526a7f2e4ee64");
      return true;
    } catch (err) {
      const e = err as BusinessError;
      console.error('[PushHarmonyProxy] check notification failed: code=' +
      e.code + ', msg=' + e.message);
      this.WriteIsAutoPushJson(false);
      var data=systemDateTime.getTime();
      TDOpenHarmonyProxy.track("Pop_refuse","消息推送",data,"Local","2c3fcbfea2ff4842b9e526a7f2e4ee64");
      return true;
    }
  }

  // ============================================================
  // 写 IsAutoPush 到 JSON 文件（使用 C# 传入的 filesDir）
  // ============================================================
  private WriteIsAutoPushJson(enabled: boolean): void {
    try {
      if (!this.filesDir) {
        console.error('[PushHarmonyProxy] filesDir not set, skip write');
        return;
      }

      const filePath = this.filesDir + '/is_auto_push.json';
      const data = JSON.stringify({ IsAutoPush: enabled ? 1 : 0 });

      // 若文件已存在，先删除，避免残留内容
      try { fs.unlinkSync(filePath); } catch (e) { /* ignore */ }

      const file = fs.openSync(filePath, fs.OpenMode.READ_WRITE | fs.OpenMode.CREATE);
      fs.writeSync(file.fd, data);
      fs.closeSync(file);

      console.info('[PushHarmonyProxy] IsAutoPush written: ' + filePath +
        ', value=' + (enabled ? 1 : 0));
    } catch (err) {
      const e = err as BusinessError;
      console.error('[PushHarmonyProxy] write json failed: code=' + e.code +
        ', msg=' + e.message);
    }
  }

  // ============================================================
  // 发布日历类型代理提醒（使用普通通知音效）
  // ============================================================
  async PublishCalendarReminder(
    year: number, month: number, day: number,
    hour: number, minute: number, second: number,
    title: string, content: string, pushKey: string,
    ringDuration: number
  ): Promise<void> {
    try {
      if (!this.bundleName || !this.abilityName) {
        console.error('[PushHarmonyProxy] config not set; call SetConfig first');
        this.SendToUnity("OnReminderPublished",
          JSON.stringify({ success: false, pushKey: pushKey, errorMsg: 'config not set' }));
        return;
      }

      const reminderWantAgent: reminderAgentManager.WantAgent = {
        pkgName: this.bundleName,
        abilityName: this.abilityName,
        parameters: { 'pushKey': pushKey }
      };


      const reminder: reminderAgentManager.ReminderRequestCalendar = {
        reminderType: reminderAgentManager.ReminderType.REMINDER_TYPE_CALENDAR,
        dateTime: { year, month, day, hour, minute, second },
        title: title,
        content: content,
        expiredContent: content,
        notificationId: 0,
        // ★ 普通通知音效：使用 SERVICE_INFORMATION 通道
        slotType: notificationManager.SlotType.SERVICE_INFORMATION,
        ringDuration: 0,
        wantAgent: reminderWantAgent,
        actionButton: []
      };

      const reminderId: number = await reminderAgentManager.publishReminder(reminder);
      console.info('[PushHarmonyProxy] reminder published, id=' + reminderId +
        ', key=' + pushKey + ', trigger=' + year + '-' + month + '-' + day +
        ' ' + hour + ':' + minute + ':' + second);

      this.SendToUnity("OnReminderPublished",
        JSON.stringify({ success: true, reminderId: reminderId, pushKey: pushKey }));

    } catch (err) {
      const e = err as BusinessError;
      console.error('[PushHarmonyProxy] publish failed: code=' + e.code +
        ', msg=' + e.message + ', key=' + pushKey);
      this.SendToUnity("OnReminderPublished",
        JSON.stringify({
          success: false, pushKey: pushKey,
          errorCode: e.code, errorMsg: e.message
        }));
    }
  }

  async CancelAllReminders(): Promise<void> {
    try {
      await reminderAgentManager.cancelAllReminders();
      console.info('[PushHarmonyProxy] all reminders cancelled');
    } catch (err) {
      const e = err as BusinessError;
      console.error('[PushHarmonyProxy] cancelAll failed: code=' + e.code + ', msg=' + e.message);
    }
  }

  async GetValidReminders(): Promise<void> {
    try {
      const list = await reminderAgentManager.getValidReminders();
      const ids: number[] = [];
      for (let i = 0; i < list.length; i++) {
        ids.push(list[i].notificationId ?? 0);
      }
      console.info('[PushHarmonyProxy] valid reminders count=' + ids.length);
      this.SendToUnity("OnValidReminders", JSON.stringify({ ids: ids }));
    } catch (err) {
      const e = err as BusinessError;
      console.error('[PushHarmonyProxy] getValid failed: code=' + e.code + ', msg=' + e.message);
    }
  }

  SendToUnity(method: string, data: string): void {
    console.info('[PushHarmonyProxy] SendToUnity ' + method + ': ' + data);
  }
}

// ============================================================
// 注册函数
// ============================================================
export function RegisterPushHarmonyProxy(): Record<string, Object> {
  const bridge: PushHarmonyProxy = new PushHarmonyProxy();
  return { 'PushHarmonyProxy': bridge };
}