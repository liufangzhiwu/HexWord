import { attributionManager } from '@kit.StoreKit';
import { BusinessError } from '@kit.BasicServicesKit';

declare function require(module: string): any;
// 引用 C# 的静态方法（包名需与实际命名空间一致）
const CSharpBridge = require('middleware').Middleware.HuaWeiHarAttribution;

export class AttributionBridge {
    // 原有上报转化方法
    reportConversion(eventCode: number): void {
        const triggerInfo: attributionManager.AdTriggerInfo = {
            businessScene: 5,
            triggerData: eventCode,
            //timestamp: Date.now(),
        };
        attributionManager.registerTrigger(triggerInfo)
            .then(() => {
                console.info(`Attribution event ${eventCode} reported successfully`);
            })
            .catch((err: BusinessError) => {
                console.error(`Failed to report event ${eventCode}: ${err.message}`);
            });
    }

    // 新增：请求归因信息，传入应用包名
    requestAttributionInfo(packageName: string): void {
        attributionManager.getAttributionInfo(packageName)
            .then((info) => {
                const json = JSON.stringify(info);
                console.info('AttributionInfo received: ' + json);
                // 回调给 C# 的静态方法
                if (CSharpBridge && CSharpBridge.OnAttributionReceived) {
                    CSharpBridge.OnAttributionReceived(json);
                }
            })
            .catch((err: BusinessError) => {
                console.error(`getAttributionInfo failed: ${err.message}`);
                // 失败时也可以回调，传空字符串
                if (CSharpBridge && CSharpBridge.OnAttributionReceived) {
                    CSharpBridge.OnAttributionReceived('');
                }
            });
    }
}

// 注册函数保持不变
export function RegisterAttributionBridge() {
    let register = {}
    register["AttributionBridge"] = new AttributionBridge();
    return register;
}