// ====================================================================
// AttributionBridge.tslib
// 描述: 鸿蒙「应用归因服务」ArkTS 侧桥接
//      C# 侧通过 new OpenHarmonyJSObject("AttributionBridge") 调用
// 说明: 鸿蒙没有客户端渠道查询接口（channel/taskid/callback），
//      客户端只做「登记转化事件」，归因结果由华为回传服务端。
// ====================================================================
import { attributionManager } from '@kit.StoreKit';
import { BusinessError } from '@kit.BasicServicesKit';

const TAG = '[AttributionBridge]';
// 业务场景默认值（取值范围 [0,99]，C# 侧会传入真实值，此处仅兜底）
const DEFAULT_BUSINESS_SCENE: number = 5;

export class AttributionBridge {

    // 登记转化事件
    // eventCode:    转化事件 ID（与云端管理台登记的 ID 一致）
    // businessScene: 业务场景标识，取值 [0,99]，可空（缺省用 DEFAULT_BUSINESS_SCENE）
    reportConversion(eventCode: number, businessScene?: number): void {
        // C# 侧统一按字符串传参，这里做整数化校验
        const code: number = Number(eventCode);
        let scene: number = businessScene === undefined ? DEFAULT_BUSINESS_SCENE : Number(businessScene);

        if (!Number.isFinite(code) || code <= 0 || !Number.isInteger(code)) {
            console.error(`${TAG} invalid triggerData: ${eventCode}`);
            return;
        }
        // triggerData 是「转化事件编码」：标准转化事件 1~200，自定义转化事件 501~600。
        // 注意：不要传云端管理台显示的「事件ID」（如 133299182），否则服务端返回 401 参数错误。
        if (!((code >= 1 && code <= 200) || (code >= 501 && code <= 600))) {
            console.error(`${TAG} triggerData 越界: ${code}。转化事件编码范围：标准 1~200 / 自定义 501~600。`);
            return;
        }
        if (!Number.isFinite(scene) || scene < 0 || scene > 99 || !Number.isInteger(scene)) {
            console.error(`${TAG} invalid businessScene: ${businessScene}`);
            scene = DEFAULT_BUSINESS_SCENE;
        }

        const triggerInfo: attributionManager.AdTriggerInfo = {
            businessScene: scene,
            triggerData: code
        };

        try {
            attributionManager.registerTrigger(triggerInfo)
                .then(() => {
                    console.info(`${TAG} registerTrigger success, triggerData=${code}`);
                })
                .catch((err: BusinessError) => {
                    console.error(`${TAG} registerTrigger failed, code=${err.code}, msg=${err.message}, triggerData=${code}`);
                });
        } catch (error) {
            const err = error as BusinessError;
            console.error(`${TAG} registerTrigger exception, code=${err.code}, msg=${err.message}`);
        }
    }
}

// 注册函数：C# 侧 OpenHarmonyJSObject 的 key 必须与下面一致
export function RegisterAttributionBridge(): Record<string, Object> {
    return {
        'AttributionBridge': new AttributionBridge()
    };
}
