<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="chengyu.idiom.hexa.zen.honor">

    <!-- 如下为本广告sdk声明使用的权限，仅做公示，无须您手动添加，如您有手动删除，请根据您的实际场景检查是否需要使用 -->
    <!--允许程序打开网络套接字-->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--允许程序获取网络状态-->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--允许程序获取设备应用安装状态，荣耀广告将该权限用于判断对应应用是否在用户手机安装，避免投放错误广告，提高用户体检。-->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 以下权限为SDK动态使用，需要您在自己的AndroidManifest.xml中声明使用-->
    <!--允许程序访问CellID或WiFi热点来获取粗略的位置-->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--允许程序访问如GPS获取精准位置-->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    
    <application android:usesCleartextTraffic="true">
        
<!--        <activity android:name="com.unity3d.player.UnityPlayerActivity"-->
<!--                  android:theme="@style/UnityThemeSelector">-->
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->
<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->
<!--            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />-->
<!--        </activity>-->
        <activity android:name="com.mygame.honor.MyGameActivity"
                  android:extractNativeLibs="true"
                  android:label="@string/app_name"
                  android:exported="true"
                  android:hardwareAccelerated="true"
                  android:windowSoftInputMode="adjustPan|stateHidden"
                  android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>
    </application>
</manifest>
 